@{
    ViewData["Title"] = "Home";
    var specialties = ViewBag.Specialties as IEnumerable<DoctorAppointmentSystem.DTOs.SpecialtyResponse> ?? new List<DoctorAppointmentSystem.DTOs.SpecialtyResponse>();
    var featuredDoctors = ViewBag.FeaturedDoctors as IEnumerable<DoctorAppointmentSystem.DTOs.DoctorResponse> ?? new List<DoctorAppointmentSystem.DTOs.DoctorResponse>();
}

<!-- Hero -->
<div class="hero-section text-center">
    <div class="container">
        <h1><i class="bi bi-heart-pulse-fill me-3"></i>Your Health, Our Priority</h1>
        <p class="mb-4">Book Online or In-Clinic appointments with top specialists — fast, easy, secure.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-light btn-lg px-4">
                <i class="bi bi-search me-2"></i>Find a Doctor
            </a>
            @if (Context.Session.GetString("Token") == null)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-person-plus me-2"></i>Register Free
                </a>
            }
        </div>
        <div class="mt-4 d-flex justify-content-center gap-4 text-white-50 small">
            <span><i class="bi bi-people-fill me-1"></i>@ViewBag.TotalDoctors Doctors</span>
            <span><i class="bi bi-tags-fill me-1"></i>@ViewBag.TotalSpecialties Specialties</span>
            <span><i class="bi bi-shield-check-fill me-1"></i>Secure Booking</span>
        </div>
    </div>
</div>

<!-- Appointment Modes -->
<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body p-4 d-flex gap-4 align-items-start">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-2">
                    <i class="bi bi-camera-video-fill"></i>
                </div>
                <div>
                    <h5 class="fw-bold">Online Consultation</h5>
                    <p class="text-muted mb-2">Teleconsultation from the comfort of your home. Get a secure video meeting link instantly after booking.</p>
                    <a asp-controller="Doctors" asp-action="Index" asp-route-mode="1" class="btn btn-sm btn-success">
                        Book Online <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body p-4 d-flex gap-4 align-items-start">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-2">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div>
                    <h5 class="fw-bold">In-Clinic Visit</h5>
                    <p class="text-muted mb-2">Visit the doctor at the clinic. Get the exact room and location details after booking your slot.</p>
                    <a asp-controller="Doctors" asp-action="Index" asp-route-mode="2" class="btn btn-sm btn-primary">
                        Book In-Clinic <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Specialties -->
<div class="mb-5">
    <h3 class="section-title mb-4"><i class="bi bi-tags me-2 text-primary"></i>Browse by Specialty</h3>
    <div class="row g-3">
        @foreach (var s in specialties)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Doctors" asp-action="Index" asp-route-specialtyId="@s.Id"
                   class="card text-center text-decoration-none h-100 specialty-card">
                    <div class="card-body py-3">
                        <div class="fs-2 mb-2 text-primary">
                            @{
                                var icon = s.Name switch {
                                    "Cardiology" => "bi-heart-pulse",
                                    "Dermatology" => "bi-person-check",
                                    "Orthopedics" => "bi-bandaid",
                                    "Pediatrics" => "bi-emoji-smile",
                                    _ => "bi-clipboard2-pulse"
                                };
                            }
                            <i class="bi @icon"></i>
                        </div>
                        <div class="fw-semibold small">@s.Name</div>
                        <div class="text-muted" style="font-size:.75rem">@s.DoctorCount doctors</div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- Featured Doctors -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="section-title mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Featured Doctors</h3>
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
    </div>
    <div class="row g-4">
        @foreach (var doc in featuredDoctors)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card doctor-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex gap-3 align-items-start mb-3">
                            <div class="doctor-avatar">@doc.FullName[3]</div>
                            <div>
                                <h6 class="fw-bold mb-0">@doc.FullName</h6>
                                <div class="text-muted small">@doc.SpecialtyName</div>
                                <span class="badge mt-1 @(doc.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online ? "mode-badge-online" : "mode-badge-offline")">
                                    <i class="bi @(doc.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online ? "bi-camera-video" : "bi-hospital") me-1"></i>
                                    @doc.Mode
                                </span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-primary">$@doc.ConsultationFee</span>
                            <a asp-controller="Doctors" asp-action="Detail" asp-route-id="@doc.Id"
                               class="btn btn-sm btn-outline-primary">Book Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- How it works -->
<div class="card bg-primary text-white mb-4">
    <div class="card-body p-5">
        <h3 class="text-center fw-bold mb-4">How It Works</h3>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="fs-1 mb-2"><i class="bi bi-search"></i></div>
                <h6 class="fw-bold">1. Find a Doctor</h6>
                <p class="small opacity-75">Browse by specialty or appointment mode</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 mb-2"><i class="bi bi-calendar-check"></i></div>
                <h6 class="fw-bold">2. Pick a Slot</h6>
                <p class="small opacity-75">Choose a date and available time slot</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 mb-2"><i class="bi bi-check-circle"></i></div>
                <h6 class="fw-bold">3. Confirm</h6>
                <p class="small opacity-75">Receive booking confirmation instantly</p>
            </div>
            <div class="col-md-3">
                <div class="fs-1 mb-2"><i class="bi bi-camera-video"></i></div>
                <h6 class="fw-bold">4. Consult</h6>
                <p class="small opacity-75">Join online or visit the clinic</p>
            </div>
        </div>
    </div>
</div>
