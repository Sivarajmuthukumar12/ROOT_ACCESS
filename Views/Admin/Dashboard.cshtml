@model DoctorAppointmentSystem.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h2 class="section-title mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Admin Dashboard</h2>
    <p class="text-muted small mb-0">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
</div>

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Doctors</div>
                        <div class="stat-value text-primary">@Model.TotalDoctors</div>
                    </div>
                    <i class="bi bi-person-badge stat-icon text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:#198754">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Patients</div>
                        <div class="stat-value text-success">@Model.TotalPatients</div>
                    </div>
                    <i class="bi bi-people stat-icon text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:#fd7e14">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Today</div>
                        <div class="stat-value text-warning">@Model.TodayAppointments</div>
                    </div>
                    <i class="bi bi-calendar-day stat-icon text-warning"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card" style="border-left-color:#6f42c1">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Revenue Today</div>
                        <div class="stat-value text-purple" style="color:#6f42c1">$@Model.TodayRevenue</div>
                    </div>
                    <i class="bi bi-currency-dollar stat-icon" style="color:#6f42c1"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Today's Summary -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-bar-chart me-2 text-primary"></i>Today's Summary
            </div>
            <div class="card-body">
                @if (Model.TodaySummary != null)
                {
                    <h6 class="text-muted small fw-semibold text-uppercase mb-2">By Mode</h6>
                    @foreach (var m in Model.TodaySummary.ByMode)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                            <span class="badge @(m.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online ? "mode-badge-online" : "mode-badge-offline")">
                                @m.Mode
                            </span>
                            <span class="small">@m.Count appts</span>
                            <span class="small text-success fw-semibold">$@m.Revenue</span>
                        </div>
                    }

                    <h6 class="text-muted small fw-semibold text-uppercase mb-2 mt-3">By Specialty</h6>
                    @foreach (var s in Model.TodaySummary.BySpecialty)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span>@s.Specialty</span>
                            <span class="text-muted">@s.Count appts</span>
                            <span class="text-success fw-semibold">$@s.Revenue</span>
                        </div>
                    }

                    @if (!Model.TodaySummary.ByMode.Any())
                    {
                        <p class="text-muted text-center py-3">No appointments today.</p>
                    }
                }
            </div>
            <div class="card-footer bg-white">
                <a asp-action="Appointments" asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
                   class="btn btn-sm btn-outline-primary w-100">View Today's Appointments</a>
            </div>
        </div>
    </div>

    <!-- Recent Appointments -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white fw-bold d-flex justify-content-between">
                <span><i class="bi bi-clock-history me-2 text-primary"></i>Recent Appointments</span>
                <a asp-action="Appointments" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Mode</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.RecentAppointments)
                            {
                                <tr>
                                    <td class="small">@a.PatientName</td>
                                    <td class="small">@a.DoctorName</td>
                                    <td class="small">@a.AppointmentDate.ToString("MMM d")</td>
                                    <td>
                                        <span class="badge @(a.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online ? "mode-badge-online" : "mode-badge-offline") small">
                                            @a.Mode
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var sc = a.Status switch {
                                                DoctorAppointmentSystem.Models.AppointmentStatus.Confirmed => "badge-confirmed",
                                                DoctorAppointmentSystem.Models.AppointmentStatus.Completed => "badge-completed",
                                                DoctorAppointmentSystem.Models.AppointmentStatus.Cancelled => "badge-cancelled",
                                                DoctorAppointmentSystem.Models.AppointmentStatus.NoShow    => "badge-noshow",
                                                _ => "badge-pending"
                                            };
                                        }
                                        <span class="badge @sc small">@a.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
