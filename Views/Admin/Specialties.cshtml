@model IEnumerable<DoctorAppointmentSystem.DTOs.SpecialtyResponse>
@{
    ViewData["Title"] = "Manage Specialties";
}

<div class="page-header">
    <h2 class="section-title mb-0"><i class="bi bi-tags me-2 text-primary"></i>Manage Specialties</h2>
</div>

<div class="row g-4">
    <!-- List -->
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Active Doctors</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="text-muted small">@s.Id</td>
                                <td class="fw-semibold">@s.Name</td>
                                <td class="text-muted small">@(s.Description ?? "—")</td>
                                <td>
                                    <span class="badge bg-primary">@s.DoctorCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Form -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-plus-circle me-2 text-primary"></i>Add Specialty
            </div>
            <div class="card-body">
                <form asp-action="CreateSpecialty" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Name *</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Neurology" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea name="description" class="form-control" rows="2"
                                  placeholder="Brief description..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus me-1"></i>Add Specialty
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
