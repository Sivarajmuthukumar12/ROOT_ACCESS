@model DoctorAppointmentSystem.ViewModels.CreateDoctorViewModel
@{
    ViewData["Title"] = "Add Doctor";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Add New Doctor</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateDoctor" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Dr. Jane Smith" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" placeholder="doctor@clinic.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small"></label>
                            <input asp-for="Phone" class="form-control" placeholder="+1 555 000 0000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ConsultationFee" class="form-control" placeholder="75.00" />
                            </div>
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SpecialtyId" class="form-label fw-semibold small"></label>
                            <select asp-for="SpecialtyId" class="form-select">
                                <option value="">-- Select Specialty --</option>
                                @foreach (var s in Model.Specialties)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Mode" class="form-label fw-semibold small"></label>
                            <select asp-for="Mode" class="form-select">
                                <option value="">-- Select Mode --</option>
                                <option value="1">🎥 Online (Teleconsultation)</option>
                                <option value="2">🏥 Offline (In-Clinic)</option>
                            </select>
                            <span asp-validation-for="Mode" class="text-danger small"></span>
                            <div class="form-text text-warning small">
                                <i class="bi bi-exclamation-triangle me-1"></i>Cannot be changed after creation.
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="ClinicLocation" class="form-label fw-semibold small"></label>
                            <input asp-for="ClinicLocation" class="form-control" placeholder="Room 101, Main Clinic (for Offline only)" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Bio" class="form-control" rows="3"
                                      placeholder="Brief professional bio..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-2"></i>Add Doctor
                        </button>
                        <a asp-action="Doctors" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScripts") }
