@model DoctorAppointmentSystem.DTOs.AppointmentResponse
@{
    var isOnline = Model.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online;
    var statusClass = Model.Status switch {
        DoctorAppointmentSystem.Models.AppointmentStatus.Confirmed => "badge-confirmed",
        DoctorAppointmentSystem.Models.AppointmentStatus.Completed => "badge-completed",
        DoctorAppointmentSystem.Models.AppointmentStatus.Cancelled => "badge-cancelled",
        DoctorAppointmentSystem.Models.AppointmentStatus.NoShow    => "badge-noshow",
        _ => "badge-pending"
    };
    var canCancel = Model.Status == DoctorAppointmentSystem.Models.AppointmentStatus.Confirmed
                 || Model.Status == DoctorAppointmentSystem.Models.AppointmentStatus.Pending;
}

<div class="card h-100">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <h6 class="fw-bold mb-0">@Model.DoctorName</h6>
                <div class="text-muted small">@Model.SpecialtyName</div>
            </div>
            <span class="badge @statusClass px-2 py-1">@Model.Status</span>
        </div>

        <div class="row g-1 small text-muted mb-2">
            <div class="col-6">
                <i class="bi bi-calendar3 me-1"></i>@Model.AppointmentDate.ToString("MMM d, yyyy")
            </div>
            <div class="col-6">
                <i class="bi bi-clock me-1"></i>@Model.SlotStart.ToString("h:mm tt")
            </div>
            <div class="col-6">
                <span class="badge @(isOnline ? "mode-badge-online" : "mode-badge-offline") small">
                    <i class="bi @(isOnline ? "bi-camera-video" : "bi-hospital") me-1"></i>@Model.Mode
                </span>
            </div>
            <div class="col-6">
                <i class="bi bi-currency-dollar me-1"></i><strong class="text-primary">$@Model.ConsultationFee</strong>
            </div>
        </div>

        @if (isOnline && !string.IsNullOrEmpty(Model.MeetingLink) && canCancel)
        {
            <a href="@Model.MeetingLink" target="_blank" class="btn btn-sm btn-success w-100 mb-2">
                <i class="bi bi-camera-video me-1"></i>Join Meeting
            </a>
        }

        @if (!isOnline && !string.IsNullOrEmpty(Model.ClinicLocation))
        {
            <p class="small text-muted mb-2">
                <i class="bi bi-geo-alt me-1 text-danger"></i>@Model.ClinicLocation
            </p>
        }

        @if (canCancel)
        {
            <form asp-controller="Appointments" asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                        data-confirm="Cancel this appointment?">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
            </form>
        }
    </div>
</div>
