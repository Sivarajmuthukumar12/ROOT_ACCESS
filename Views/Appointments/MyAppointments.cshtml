@model IEnumerable<DoctorAppointmentSystem.DTOs.AppointmentResponse>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2 class="section-title mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i>My Appointments</h2>
    <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary btn-sm">
        <i class="bi bi-plus me-1"></i>Book New
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <p class="text-muted mt-3">You have no appointments yet.</p>
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-2"></i>Find a Doctor
        </a>
    </div>
}
else
{
    <!-- Upcoming -->
    var upcoming = Model.Where(a => a.AppointmentDate >= DateTime.Today && a.Status != DoctorAppointmentSystem.Models.AppointmentStatus.Cancelled).OrderBy(a => a.AppointmentDate);
    var past = Model.Where(a => a.AppointmentDate < DateTime.Today || a.Status == DoctorAppointmentSystem.Models.AppointmentStatus.Cancelled).OrderByDescending(a => a.AppointmentDate);

    if (upcoming.Any())
    {
        <h5 class="fw-bold mb-3 text-success"><i class="bi bi-clock me-2"></i>Upcoming</h5>
        <div class="row g-3 mb-4">
            @foreach (var a in upcoming)
            {
                <div class="col-md-6">
                    @await Html.PartialAsync("_AppointmentCard", a)
                </div>
            }
        </div>
    }

    if (past.Any())
    {
        <h5 class="fw-bold mb-3 text-muted"><i class="bi bi-archive me-2"></i>Past / Cancelled</h5>
        <div class="row g-3">
            @foreach (var a in past)
            {
                <div class="col-md-6">
                    @await Html.PartialAsync("_AppointmentCard", a)
                </div>
            }
        </div>
    }
}
