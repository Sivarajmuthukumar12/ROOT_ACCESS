@model DoctorAppointmentSystem.DTOs.AppointmentResponse
@{
    ViewData["Title"] = "Booking Confirmed";
    var isOnline = Model.Mode == DoctorAppointmentSystem.Models.AppointmentMode.Online;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card text-center border-success">
            <div class="card-body p-5">
                <div class="text-success mb-3" style="font-size:4rem">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h3 class="fw-bold text-success">Appointment Confirmed!</h3>
                <p class="text-muted">Your appointment has been successfully booked.</p>

                <div class="card bg-light mt-4 text-start">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-muted small">Doctor</div>
                                <div class="fw-semibold">@Model.DoctorName</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Specialty</div>
                                <div class="fw-semibold">@Model.SpecialtyName</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Date</div>
                                <div class="fw-semibold">@Model.AppointmentDate.ToString("dddd, MMMM d, yyyy")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Time</div>
                                <div class="fw-semibold">@Model.SlotStart.ToString("h:mm tt") – @Model.SlotEnd.ToString("h:mm tt")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Mode</div>
                                <span class="badge @(isOnline ? "mode-badge-online" : "mode-badge-offline") px-2 py-1">
                                    <i class="bi @(isOnline ? "bi-camera-video" : "bi-hospital") me-1"></i>@Model.Mode
                                </span>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Fee</div>
                                <div class="fw-bold text-primary">$@Model.ConsultationFee</div>
                            </div>

                            @if (isOnline && !string.IsNullOrEmpty(Model.MeetingLink))
                            {
                                <div class="col-12">
                                    <div class="text-muted small">Meeting Link</div>
                                    <a href="@Model.MeetingLink" target="_blank" class="fw-semibold text-success text-break">
                                        <i class="bi bi-camera-video me-1"></i>@Model.MeetingLink
                                    </a>
                                </div>
                            }

                            @if (!isOnline && !string.IsNullOrEmpty(Model.ClinicLocation))
                            {
                                <div class="col-12">
                                    <div class="text-muted small">Clinic Location</div>
                                    <div class="fw-semibold"><i class="bi bi-geo-alt me-1 text-danger"></i>@Model.ClinicLocation</div>
                                </div>
                            }

                            <div class="col-6">
                                <div class="text-muted small">Booking ID</div>
                                <div class="fw-semibold text-muted">#@Model.Id</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Status</div>
                                <span class="badge badge-confirmed px-2 py-1">@Model.Status</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center mt-4">
                    <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-primary">
                        <i class="bi bi-calendar-check me-2"></i>My Appointments
                    </a>
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-search me-2"></i>Book Another
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
